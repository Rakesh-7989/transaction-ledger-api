PORT=3000
NODE_ENV=development
# Supabase PostgreSQL connection string.
# For local development you can use the direct connection (port 5432).
# For Vercel serverless deployment, use the pooled connection (port 6543 with ?pgbouncer=true):
#   postgresql://postgres:YOUR_PASSWORD@db.ietaijsvvytrdxzeohcm.supabase.co:6543/postgres?pgbouncer=true&connection_limit=1
# Never commit real credentials. Copy this file to .env and fill in your own values.
