PORT=3000
NODE_ENV=development
# Supabase PostgreSQL connection string (pooled, serverless-friendly).
# Example: postgresql://postgres:<password>@db.<ref>.supabase.co:6543/postgres?pgbouncer=true&connection_limit=1
# Never commit real credentials. Copy this file to .env and fill in your own values.
DATABASE_URL=postgresql://postgres:YOUR_DB_PASSWORD@db.xxxxxx.supabase.co:6543/postgres?pgbouncer=true&connection_limit=1
